<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/aboutTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="@color/royal_navy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/aboutDividerView"
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:background="@color/royal_gold"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/aboutTitleTextView"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/aboutBodyTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tenant Management System helps you record tenants, track rent paid and reach them quickly.\n\nBuilt in Kotlin by Francis Kamau, hehe, Strathmore University."
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ink"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/aboutDividerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/aboutVersionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0 still in development"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:textColor="@color/ink_muted"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/aboutBodyTextView"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tenant"
            type="com.example.tenantmanagementsystem190050.Tenant" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TENANT MANAGEMENT SYSTEM"
            android:textAlignment="center"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.08"
            android:textColor="@color/royal_navy"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/dividerView"
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:background="@color/royal_gold"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/titleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tenantNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenant Name"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="28dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/dividerView"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/tenantNameEditText"
            android:layout_width="321dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_input"
            android:hint="Enter tenant name"
            android:minHeight="52dp"
            android:padding="14dp"
            android:textColor="@color/ink"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tenantNameLabel" />

        <TextView
            android:id="@+id/phoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/tenantNameEditText"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/phoneEditText"
            android:layout_width="260dp"
            android:layout_height="53dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_input"
            android:hint="Enter phone number"
            android:inputType="phone"
            android:minHeight="52dp"
            android:padding="14dp"
            android:textColor="@color/ink"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/phoneLabel" />

        <TextView
            android:id="@+id/rentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rent Paid (KSh)"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/phoneEditText"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/rentEditText"
            android:layout_width="217dp"
            android:layout_height="46dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_input"
            android:hint="Enter Rent Paid"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:padding="14dp"
            android:textColor="@color/ink"
            app:layout_constraintEnd_toStartOf="@id/saveButton"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rentLabel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="93dp"
            android:layout_height="36dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.15"
            android:text="SAVE"
            android:textColor="@color/royal_gold_light"
            android:textStyle="bold"
            app:backgroundTint="@color/royal_navy"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="@id/rentEditText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/rentEditText"
            app:strokeColor="@color/royal_gold"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tenantNameBig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{tenant.name}"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="@color/royal_navy"
            android:layout_marginTop="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/rentEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tenantResultTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{tenant.summary()}"
            android:hint="Saved tenant will appear here"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ink"
            android:minHeight="96dp"
            android:padding="18dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/tenantNameBig"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/callButton"
            android:layout_width="229dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="24dp"
            android:letterSpacing="0.15"
            android:text="CALL TENANT"
            android:textColor="@color/royal_navy"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tenantResultTextView"
            app:strokeColor="@color/royal_gold"
            app:strokeWidth="1.5dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
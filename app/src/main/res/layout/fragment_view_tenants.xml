<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tenant"
            type="com.example.tenantmanagementsystem190050.Tenant" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/newTenantLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:fontFamily="serif"
                android:text="Just added"
                android:textColor="@color/royal_navy"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/newTenantTextView"
                android:layout_width="365dp"
                android:layout_height="150dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:text="@{tenant.summary()}"
                android:textColor="@color/ink"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.084"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newTenantLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/callButton"
                android:layout_width="221dp"
                android:layout_height="44dp"
                android:layout_marginStart="80dp"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="CALL TENANT"
                android:textColor="@color/royal_navy"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newTenantTextView"
                app:strokeColor="@color/royal_gold"
                app:strokeWidth="1.5dp" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/newTenantGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="newTenantLabel,newTenantTextView,callButton" />

            <TextView
                android:id="@+id/allTenantsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All tenants"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/royal_navy"
                android:layout_marginTop="28dp"
                app:layout_goneMarginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/callButton"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/allTenantsTextView"
                android:layout_width="311dp"
                android:layout_height="137dp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/allTenantsLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tenantNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="64dp"
        android:letterSpacing="0.1"
        android:text="Tenant Name"
        android:textAllCaps="true"
        android:textColor="@color/ink_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/tenantNameEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter tenant name"
        android:minHeight="52dp"
        android:padding="14dp"
        android:background="@drawable/bg_input"
        android:textColor="@color/ink"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tenantNameLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="@color/ink_muted"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/tenantNameEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/phoneEditText"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_input"
        android:hint="Enter phone number"
        android:inputType="phone"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="@color/ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phoneLabel" />

    <TextView
        android:id="@+id/rentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rent Paid (KSh)"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="@color/ink_muted"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/phoneEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/rentEditText"
        android:layout_width="240dp"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_input"
        android:hint="Enter Rent Paid"
        android:inputType="numberDecimal"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="@color/ink"
        app:layout_constraintEnd_toStartOf="@id/saveButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rentLabel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="97dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.15"
        android:text="SAVE"
        android:textColor="@color/royal_gold_light"
        android:textStyle="bold"
        app:backgroundTint="@color/royal_navy"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@id/rentEditText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/rentEditText"
        app:strokeColor="@color/royal_gold"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>